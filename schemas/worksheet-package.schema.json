                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "value_type",
              "values"
            ]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "keys": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "value": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "required": [
              "keys",
              "value"
            ]
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "value_type",
        "status",
        "axes",
        "rows",
        "evidence"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
