{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "../schemas/worksheet-package.schema.json"
    },
    "contract_version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "draft_research"
    },
    "production_enabled": {
      "const": false
    },
    "program": {
      "$ref": "#/$defs/program"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 1
    }
  },
  "required": [
    "$schema",
    "contract_version",
    "status",
    "production_enabled",
    "program",
    "context",
    "plan",
    "cases"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taxman:worksheet:0.1.0",
  "title": "Research worksheet with exact numeric values and annual indexed tables",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ref"
            },
            "target": {
              "type": "string",
              "pattern": "^(input|step|context):[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "kind",
            "target"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value_type": {
              "enum": [
                "Money",
                "Rate",
                "Decimal",
                "Integer",
                "Boolean",
                "Enum"
              ]
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean",
                "null"
              ]
            },
            "enum_domain": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value_type",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lookup"
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "keys": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "kind",
            "table",
            "keys"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choose"
            },
            "condition": {
              "$ref": "#/$defs/expression"
            },
            "then": {
              "$ref": "#/$defs/expression"
            },
            "else": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "kind",
            "condition",
            "then",
            "else"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "operator"
            },
            "operator": {
              "enum": [
                "add",
                "subtract",
                "min",
                "max",
                "multiply",
                "divide",
                "equal",
                "less_than",
                "less_equal",
                "and",
                "or",
                "not",
                "boolean_to_integer",
                "round"
              ]
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 28
            },
            "mode": {
              "enum": [
                "exact",
                "half_up",
                "half_even",
                "floor",
                "ceiling",
                "truncate"
              ]
            }
          },
          "required": [
            "kind",
            "operator",
            "arguments"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "round"
                  }
                }
              },
              "then": {
                "required": [
                  "scale",
                  "mode"
                ]
              },
              "else": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "scale"
                      ]
                    },
                    {
                      "required": [
                        "mode"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
