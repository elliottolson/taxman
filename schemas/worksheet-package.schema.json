                      },
                      "outcome_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/evidence"
                        }
                      }
                    },
                    "required": [
                      "status",
                      "reason"
                    ]
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "status": {
                          "enum": [
                            "value",
                            "blocked"
                          ]
                        },
                        "result": {
                          "oneOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "value": {
                                  "type": [
                                    "boolean",
                                    "string"
                                  ]
                                }
                              },
                              "required": [
                                "value"
                              ]
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "value_type": {
                                  "enum": [
                                    "Money",
                                    "Rate",
                                    "Decimal",
                                    "Integer"
                                  ]
                                },
                                "numerator": {
                                  "type": "integer"
                                },
                                "denominator": {
                                  "type": "integer",
                                  "minimum": 1
                                },
                                "value": {
                                  "type": [
                                    "string",
                                    "integer"
                                  ]
                                }
                              },
                              "required": [
                                "value_type",
                                "numerator",
                                "denominator"
                              ]
                            }
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/evidence"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "evidence"
                      ],
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "status": {
                                "const": "value"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "result"
                            ],
                            "not": {
                              "required": [
                                "reason"
                              ]
                            }
                          },
                          "else": {
                            "required": [
                              "reason"
                            ],
                            "not": {
                              "required": [
                                "result"
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  "production_enabled": {
                    "const": false
                  },
                  "interpretation_review": {
                    "const": "pending"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "plan_sha256",
                  "input_sha256",
                  "result",
                  "steps",
                  "production_enabled",
                  "interpretation_review",
                  "sha256"
                ]
              },
              "result_comparison": {
                "enum": [
                  "passed",
                  "failed"
                ]
              },
              "step_comparison": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            },
            "required": [
              "case_id",
              "fixture_sha256",
              "expected",
              "actual",
              "result_comparison",
              "step_comparison"
            ]
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "contract_version",
        "plan_sha256",
        "fixture_set_sha256",
        "runner_sources",
        "structural_validation",
        "calculation_comparison",
        "interpretation_review",
        "reference_review",
        "designated_reviewer",
        "production_eligible",
        "results",
        "sha256"
      ]
    }
  }
}
