{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taxman:planning:rule-package:0.1.0",
  "title": "TaxMan illustrative rule-package contract",
  "description": "Deliberately small planning schema, not the complete future tax-rule language. Semantic compiler checks are additional requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "id", "version", "jurisdiction", "tax_year", "status", "production_enabled", "limitations", "input_contract", "rules", "expected_derived_dependencies"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "jurisdiction": {"const": "US-FED"},
    "tax_year": {"type": "integer", "minimum": 1900, "maximum": 2200},
    "status": {"const": "illustrative"},
    "production_enabled": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "collection_complete", "fields", "invariants"],
      "properties": {
        "collection": {"type": "string"},
        "collection_complete": {"type": "string"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "state"],
            "properties": {
              "name": {"type": "string"},
              "type": {"const": "Money"},
              "state": {"const": "confirmed"}
            }
          }
        },
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "expected_derived_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "collection", "field", "requires_complete"],
          "properties": {
            "op": {"const": "sum_field"},
            "collection": {"type": "string"},
            "field": {"type": "string"},
            "requires_complete": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "rule_id"],
          "properties": {"op": {"const": "ref"}, "rule_id": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "left", "right"],
          "properties": {
            "op": {"const": "subtract"},
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "output_type", "execution", "rounding", "on_unknown", "explanation_key", "sources"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "output_type": {"const": "Money"},
        "execution": {"$ref": "#/$defs/expression"},
        "rounding": {"const": "none_exact_cents"},
        "on_unknown": {"const": "blocked"},
        "explanation_key": {"type": "string"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "locator", "claim"],
            "properties": {
              "source_id": {"type": "string"},
              "locator": {"type": "string", "minLength": 1},
              "claim": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
